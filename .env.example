# How Explainer reaches Claude:
#   auto (default)  – API key if set below, otherwise your Claude subscription via Claude Code
#   subscription    – always use the local Claude Code login (no API key needed)
#   api             – always use ANTHROPIC_API_KEY
#   mock            – demo mode without any model calls
LLM_PROVIDER=auto

# Only needed for LLM_PROVIDER=api (or auto without a Claude Code login)
ANTHROPIC_API_KEY=

# Model (default: claude-sonnet-5-5)
ANTHROPIC_MODEL=claude-sonnet-5-5

# Thinking effort: low | medium | high (default: low – fast enough for < 90 s)
ANTHROPIC_EFFORT=low

# Optional: path to the claude binary if it is not on your PATH
CLAUDE_CLI_PATH=

# Optional: higher GitHub limits (5,000 instead of 60 requests/hour) and private repos
GITHUB_TOKEN=

# Optional
PORT=8787
MAX_INPUT_CHARS=60000
